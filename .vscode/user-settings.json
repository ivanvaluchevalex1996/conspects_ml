{
  "editor.fontFamily": "JetBrains Mono",
  // "editor.fontFamily": "Iosevka",
  // "editor.fontFamily": "Operator Mono",
  // этот шрифт вот тут https://fonts-online.ru/fonts/cascadia-code
  // Cascadia Code варианты:
  // "editor.fontFamily": "Cascadia Code",
  // "editor.fontFamily": "Cascadia Code Italic",
  // "editor.fontFamily": "Cascadia Code NF",
  // "editor.fontFamily": "Cascadia Code NF Italic",
  // "editor.fontFamily": "Cascadia Code PL",
  // "editor.fontFamily": "Cascadia Code PL Italic",
  // Cascadia Mono варианты:
  // "editor.fontFamily": "Cascadia Mono",
  // "editor.fontFamily": "Cascadia Mono Italic",
  // "editor.fontFamily": "Cascadia Mono NF",
  // "editor.fontFamily": "Cascadia Mono NF Italic",
  // "editor.fontFamily": "Cascadia Mono PL",
  // "editor.fontFamily": "Cascadia Mono PL Italic",
  // Dank Mono варианты:
  // "editor.fontFamily": "Dank Mono",
  // "editor.fontFamily": "Dank Mono Bold",
  // "editor.fontFamily": "Dank Mono Italic",
  // "editor.fontLigatures": true,
  "editor.minimap.scale": 2,
  // "editor.letterSpacing": -1.4,
  "editor.fontWeight": 400,
  // "editor.fontWeight": 300,
  "editor.lineHeight": 1.5,
  "editor.quickSuggestionsDelay": 0,
  // "window.density.editorTabHeight": "compact",
  "editor.smoothScrolling": true,
  // для кастомизации отдельных элементов ссылка на видос https://www.youtube.com/shorts/dz7XhfFE9nE
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "All Text",
        "scope": [
          "text",
          "source",
          "string",
          "comment",
          "keyword",
          "storage",
          "entity",
          "variable",
          "constant",
          "support",
          "function",
          "type",
          "class",
          "interface",
          "enum",
          "meta",
          "markup",
          "punctuation",
          "invalid",
        ],
        "settings": {
          "fontStyle": "",
        },
      },
      {
        "name": "",
        "scope": ["comment"],
        "settings": {
          "fontStyle": "italic",
        },
      },
      {
        "name": "keyword.control",
        "scope": [
          "variable.other.constant.tsx",
          "storage.type.function.tsx",
          "keyword.operator.new.tsx",
          "storage.modifier.async.ts",
          "storage.type.function.arrow.ts",
          // "keyword.control.from",
          // "keyword.control.import",
          "storage.type.type.tsx",
          "keyword.operator.expression.keyof.tsx",
          "storage.type",
          "storage.modifier.async.tsx",
          "storage.type.js",
          "constant.language",
          "keyword.control",
          "storage.modifier",
          "keyword.operator.expression.keyof",
          "keyword.operator.new",
          "keyword.operator.expression.delete",
          "keyword.operator.expression.void.tsx",
          "keyword.operator.expression.typeof.ts",
          "keyword.operator.expression.import",
          "variable.language.this",
          "punctuation.definition.template-expression.begin.tsx",
          "punctuation.definition.template-expression.end.tsx",
          "keyword.operator.expression.typeof",
        ],
        "settings": {
          // "foreground": "#8d8bfb",
          // "foreground": "#dd7c8bdf"
          // "foreground": "#CC7832",
          "foreground": "#BF7C76",
          // "foreground": "#ffffff",
        },
      },
      {
        "name": "constant",
        "scope": [
          "variable.other.constant",
          "variable.other.enummember",
          "support.type.property-name.json.comments",
          "support.type.property-name.json",
        ],
        "settings": {
          // "foreground": "#7FDBCA",
          // "foreground": "#c190dbe0",
          // "foreground": "#9876AA",
          // "foreground": "#a582b8",
          "foreground": "#997fbcdc",
          // "fontStyle": "italic bold",
          // "fontStyle": "italic",
          "fontStyle": "bold",
        },
      },
      {
        "name": "функции",
        "scope": ["entity.name.function", "support.function"],
        "settings": {
          "foreground": "#8292C7",
          // "foreground": "#87a4e3"
          // "foreground": "#62a3feee"
        },
      },
      {
        "name": "цифры",
        "scope": ["constant.numeric.decimal"],
        "settings": {
          "fontStyle": "bold",
        },
      },
      {
        "name": "теги в разметке",
        "scope": [
          "support.class.component.tsx",
          "entity.name.type",
          "support.type.builtin",
          "support.class",
          "support.type",
        ],
        "settings": {
          "foreground": "#009385",
          // "foreground": "#2fbaa3e1",
        },
      },
      {
        "name": "comment",
        "scope": ["comment"],
        "settings": {
          "foreground": "#c4f20b8c",
        },
      },
      {
        "name": "зеленый цвет импортов и тд",
        "scope": ["string.quoted.double", "string.template"],
        "settings": {
          "foreground": "#799F8A",
          // "foreground": "#70917f",
        },
      },
      {
        "name": "words gray",
        "scope": [
          "variable.other.readwrite.alias",
          "variable.other.property",
          "variable.parameter",
          "entity.other.attribute-name",
          "variable.other.readwrite.alias",
          "variable.other.property",
          "variable.other.readwrite",
          "support.type.property-name.css",
          "variable.other.object.property",
          "variable.other.readwrite",
          "meta.jsx.children",
          "support.type.vendored.property-name",
          "meta.object-literal.key",
          "variable.other.object",
          "meta.property-value.scss",
          "keyword.operator.logical",
          "punctuation",
          "meta.brace.round",
          "meta.brace.square",
          "keyword.operator.type",
          "keyword.operator.assignment",
          "punctuation.section.embedded",
          "support.variable.property",
          "variable.other.readwrite",
          "meta.property-name",
        ],
        "settings": {
          "foreground": "#cdcdcdcf",
        },
      },
      {
        "name": "! important",
        "scope": ["keyword.other.important"],
        "settings": {
          "foreground": "#fc2828",
        },
      },
      {
        "name": "логические операторы",
        "scope": [
          "keyword.operator.logical",
          "support.variable",
          /* "keyword.control.flow" */
        ],
        "settings": {
          "foreground": "#ffff00",
        },
      },
      {
        "name": "constant.numeric.decimal",
        "scope": ["constant.numeric.decimal"],
        "settings": {
          // "foreground": "#2CABB8",
          "fontStyle": "italic bold",
        },
      },
      {
        "name": "meta.jsx.children",
        "scope": ["meta.jsx.children"],
        "settings": {
          // "foreground": "#dadb83e3",
          "foreground": "#dadb83bc",
          "fontStyle": "italic",
        },
      },
      {
        "name": "meta",
        "scope": ["support.variable.property"],
        "settings": {
          "foreground": "#cdcdcdcf",
        },
      },
      {
        "name": "теги",
        "scope": ["entity.name.tag"],
        "settings": {
          // "foreground": "#EB606B"
          "foreground": "#d5636dd5",
          // "foreground": "#ed929ad9"
        },
      },
      {
        "name": "теги",
        "scope": ["punctuation.definition.tag"],
        "settings": {
          "foreground": "#2fbaa3e1",
        },
      },
    ],
  },
  // "breadcrumbs.enabled": false,
  //для липкой прокрутки файлов
  "workbench.tree.enableStickyScroll": true,
  // отступ в папках
  // "workbench.tree.indent": 12,
  "editor.stickyScroll.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "explorer.confirmDelete": false,
  "editor.wordWrap": "on",
  "editor.semanticHighlighting.enabled": true,
  "editor.cursorBlinking": "phase",
  "editor.cursorStyle": "line",
  "editor.indentSize": "tabSize",
  "gitlens.advanced.messages": {
    "suppressIntegrationDisconnectedTooManyFailedRequestsWarning": true,
  },
  "explorer.compactFolders": false,
  "liveServer.settings.AdvanceCustomBrowserCmdLine": "",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.formatOnSave": true,
  // СТИЛИ ДЛЯ ТЕРМИНАЛА
  "terminal.integrated.fontFamily": "Cascadia Code PL",
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.localEchoStyle": "dim",
  "gitlens.currentLine.enabled": true,
  "gitlens.currentLine.dateFormat": "Do MMMM, YYYY",
  "gitlens.currentLine.format": "${author} • ${date} • ${message} ",
  "gitlens.currentLine.pullRequests.enabled": true,
  "gitlens.currentLine.scrollable": true,
  "gitlens.codeLens.enabled": false,
  "git.enableSmartCommit": true,
  "explorer.confirmDragAndDrop": false,
  "git.confirmSync": false,
  "workbench.editorAssociations": {
    "*.zip": "default",
    "*.svg": "default",
  },
  "editor.bracketPairColorization.enabled": true,
  "turboConsoleLog.logMessagePrefix": "🟢 ",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "workbench.colorCustomizations": {
    // GitLens настройки для яркого отображения автора
    "gitlens.trailingLineForegroundColor": "#abababc9",
    "gitlens.unpublishedChangesLineHighlightBackgroundColor": "#2d1a00",
    "gitlens.unpublishedChangesLineHighlightOverviewRulerColor": "#ffaa00",
    // "editor.selectionBackground": "#81334e",
    "editor.lineHighlightBackground": "#212020",
    // для кнопки
    // "button.background": "#175d1f",
    // "button.hoverBackground": "#1e7a29",
    // "badge.background":"#175d1f",
    // "profileBadge.background":"#175d1f",
    // "activityBarBadge.background": "#ff0000",
    // "activityBarBadge.foreground": "#ffffff",
    "badge.foreground": "#ffffff",
    // для табов
    "editorGroupHeader.tabsBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#ffffff",
    // border для табов
    "tab.activeBackground": "#362e5f",
    // "tab.activeBorder": "#AA9BF5",
    // "tab.activeBorderTop": "#AA9BF5",
    "tab.inactiveBorder": "#d9d9d952",
    "editor.background": "#000000",
    "menubar.selectionBackground": "#000000",
    "menu.background": "#131322",
    "sideBar.background": "#000000",
    // "statusBar.background": "#000000",
    // "statusBar.foreground": "#ffffff",
    "activityBar.background": "#000000",
    "panel.background": "#000000",
    "panel.border": "#d9d9d9a7",
    "sideBar.border": "#d9d9d952",
    "panelSection.border": "#201f1f",
    "panelTitleBadge.background": "#ff0202",
    "panelSectionHeader.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#b2b8b1ea",
    "terminalCursor.foreground": "#11ff00",
    "editorLineNumber.activeForeground": "#ff43b4",
    "sideBarSectionHeader.background": "#000000",
    "tree.indentGuidesStroke": "#AA9BF5",
    "tree.tableColumnsBorder": "#AA9BF5",
    "button.background": "#5f1d73",
    "button.hoverBackground": "#4d175d",
    "button.hoverForeground": "#ffffff",
    "button.border": "#5f1d73",
    "button.hoverBorder": "#4d175d",
    "activityBarBadge.background": "#b56bcc",
    "badge.background": "#5f1d737c",
    "activityBarBadge.foreground": "#ffffff",
    "statusBarItem.remoteBackground": "#b56bcca9",
    "titleBar.activeBackground": "#080808ec",
    "editorCursor.foreground": "#11ff00",
  },
  "explorer.confirmPasteNative": false,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": false,
  },
  "editor.inlayHints.fontSize": 14,
  "editor.inlayHints.padding": true,
  "workbench.iconTheme": "ayu",
  "terminal.integrated.tabs.defaultIcon": "diff-modified",
  "terminal.integrated.cursorStyleInactive": "none",
  "diffEditor.codeLens": true,
  "editor.inlineSuggest.showToolbar": "always",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
    },
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.fontSize": 14,
  "notebook.markup.fontSize": 13,
  "notebook.output.fontSize": 12,
  "notebook.lineHeight": 20,
  "markdown.preview.fontSize": 13,
  "editor.inlayHints.maximumLength": 100,
  // "editor.inlayHints.fontFamily": "Cascadia Code PL Italic",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "workbench.editor.empty.hint": "hidden",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "editor.minimap.enabled": true,
  "workbench.activityBar.orientation": "vertical",
  "git.autofetch": true,
  "workbench.editor.enablePreview": false,
  "cursor.cpp.disabledLanguages": ["markdown", "plaintext"],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "editor.mouseWheelZoom": true,
  "terminal.integrated.mouseWheelZoom": true,
  "codeium.enableCodeLens": false,
  "terminal.integrated.commandsToSkipShell": [
    "kilo-code.new.agentManagerOpen",
    "kilo-code.new.agentManager.showTerminal",
    "kilo-code.new.agentManager.previousTerminal",
    "kilo-code.new.agentManager.nextTerminal",
  ],
  "kilo-code.new.agentWorkStyle": "unset",
  "kilo-code.new.language": "ru",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "roo-cline.debug": false,
  "roo-cline.allowedCommands": ["git log", "git diff", "git show"],
  "roo-cline.deniedCommands": [],
  "terminal.integrated.initialHint": false,
  "files.autoSave": "afterDelay",
  "window.confirmSaveUntitledWorkspace": false,
  "terminal.integrated.fontSize": 12,
  "workbench.colorTheme": "JetBrains New Dark",
  "jupyter.askForKernelRestart": false,
}
